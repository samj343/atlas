# Atlas environment configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Only deployment-specific settings live here. Research parameters belong in the
# version-controlled YAML under configs/, so that every stored result can be
# traced back to the exact settings that produced it.

# ---------------------------------------------------------------------------
# Execution mode
# ---------------------------------------------------------------------------
# backtest | dry_run | paper
#
#   backtest  research only; no broker connection
#   dry_run   compute orders and print them; never submit          (DEFAULT)
#   paper     submit to an Interactive Brokers PAPER account
#
# `live` is NOT implemented. It is rejected at configuration load and again by
# the pre-trade safety gate. Atlas is a paper-trading system.
EXECUTION_MODE=dry_run

# ---------------------------------------------------------------------------
# Interactive Brokers connection
# ---------------------------------------------------------------------------
# Ports: 7497 TWS paper, 7496 TWS live, 4002 IB Gateway paper, 4001 Gateway live.
# Atlas refuses to trade a non-paper account regardless of the port used.
ATLAS_IBKR_HOST=127.0.0.1
ATLAS_IBKR_PORT=7497
ATLAS_IBKR_CLIENT_ID=17

# Comma-separated allowlist of account identifiers Atlas may trade.
# REQUIRED before any order can be submitted in paper mode. Paper accounts are
# prefixed 'DU'. Leave empty to keep submission blocked.
ATLAS_IBKR_ACCOUNT_ALLOWLIST=

# ---------------------------------------------------------------------------
# Global kill switch
# ---------------------------------------------------------------------------
# Set to 1/true to block every order creation and submission, everywhere.
ATLAS_KILL_SWITCH=0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. Defaults to a local SQLite file under data/database/.
# Example PostgreSQL: postgresql+psycopg://atlas:password@localhost:5432/atlas
# ATLAS_DATABASE_URL=sqlite:///data/database/atlas.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_JSON=0

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Override the detected project root (rarely needed).
# ATLAS_PROJECT_ROOT=/opt/atlas

# NOTE: Atlas never reads a broker username, password or API key. The IB API
# authenticates through a TWS/Gateway session that you log into yourself.
